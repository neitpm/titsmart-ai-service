# ==============================================================================
# TITSmart AI Service - Environment Configuration (.env.example)
# ==============================================================================

# Application Environment
APP_NAME="TITSmart AI Service"
APP_ENV=development
DEBUG=True
PORT=8000

# Authentication & Security
AUTH_MODE=mock
INTERNAL_AUTH_SECRET=your_internal_auth_secret_for_mock_proxy
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
JWT_AUDIENCE=authenticated

# Supabase Staging Connection (READ-ONLY)
# CHÚ Ý BẢO MẬT: SUPABASE_ENV chỉ chấp nhận 'development' hoặc 'staging'. CẤM TUYỆT ĐỐI 'production'.
SUPABASE_ENV=development
SUPABASE_ALLOWED_PROJECT_REF=your-staging-ref
SUPABASE_URL=https://your-staging-ref.supabase.co
SUPABASE_ANON_KEY=your_read_only_anon_key
SUPABASE_REQUEST_TIMEOUT=10.0

# LLM General Settings
# CHÚ Ý BẢO MẬT: LLM_MODE chỉ chấp nhận 'mock' hoặc 'staging'. CẤM TUYỆT ĐỐI 'production'.
LLM_MODE=mock
LLM_REQUEST_TIMEOUT=10.0

# Ollama Local Integration
# Ràng buộc an toàn:
# - OLLAMA_BASE_URL: Bắt buộc là local loopback (http://127.0.0.1:11434 hoặc http://localhost:11434). Cấm gửi dữ liệu ra cloud/internet.
# - OLLAMA_PRIMARY_MODEL: qwen3:8b cho LLM generation.
# - OLLAMA_FALLBACK_MODEL: qwen3:4b tự động kích hoạt fallback khi qwen3:8b gặp lỗi hoặc timeout.
# - OLLAMA_EMBEDDING_MODEL: bge-m3:latest (1024 dimensions). CẤM TUYỆT ĐỐI dùng bge-m3 để trò chuyện / sinh văn bản.
# - OLLAMA_EMBEDDING_DIMENSIONS: 1024 (chuẩn vector dimension của bge-m3:latest).
# - OLLAMA_REQUEST_TIMEOUT: 30.0 (fail-closed timeout theo giây khi gọi Ollama local).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_PRIMARY_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_EMBEDDING_DIMENSIONS=1024
OLLAMA_REQUEST_TIMEOUT=30.0
